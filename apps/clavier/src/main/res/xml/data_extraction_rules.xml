<?xml version="1.0" encoding="utf-8"?>
<!--
    Rien ne quitte l'appareil (apps/clavier/docs/spec-v1.md §3.5) : ni sauvegarde dans le cloud,
    ni transfert vers un nouvel appareil. allowBackup="false" ne suffit pas à bloquer le transfert
    d'appareil à appareil depuis Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
