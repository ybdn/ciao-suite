#!/bin/sh
# Format des messages de commit de la suite C!ao (docs/workflow-git.md, section 2).
# Activation : git config core.hooksPath .githooks

subject=$(grep -v '^#' "$1" | sed -n '1p')

# Messages générés par Git (fusion, annulation, fixup/squash d'un rebase) : acceptés tels quels.
if printf '%s' "$subject" | grep -Eq '^(Merge |Revert "|fixup! |squash! |amend! )'; then
    exit 0
fi

pattern='^(feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    echo "✖ Message de commit hors format : « $subject »"
    echo "  Attendu : <type>(<portée>): <description>, sans point final"
    echo "  Ex.     : feat(galerie): albums personnalisés"
    echo "  Types   : feat fix refactor perf test docs style build ci chore revert"
    echo "  (docs/workflow-git.md, section 2)"
    exit 1
fi

length=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$length" -gt 100 ]; then
    echo "✖ Première ligne trop longue ($length caractères, 100 maximum, viser 72)."
    exit 1
fi
